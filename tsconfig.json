{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "skipLibCheck": true
  }
}
